# Headers de seguridad para todas las rutas
/*
  # Previene clickjacking
  X-Frame-Options: DENY

  # Previene MIME-sniffing
  X-Content-Type-Options: nosniff

  # Control de referrer
  Referrer-Policy: strict-origin-when-cross-origin

  # Deshabilita APIs que la app no usa
  Permissions-Policy: camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

  # Fuerza HTTPS
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Content Security Policy: Turnstile y Supabase son los únicos orígenes externos
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://spb-palettelab.fluxdv.icu https://challenges.cloudflare.com https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; media-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# Assets con hash en el nombre: cache inmutable
/assets/*
  Cache-Control: public, max-age=31536000, s-maxage=2592000, immutable

# Imágenes y favicon
/*.svg
  Cache-Control: public, max-age=31536000, s-maxage=604800

/*.ico
  Cache-Control: public, max-age=31536000, s-maxage=604800

/*.png
  Cache-Control: public, max-age=31536000, s-maxage=604800

/*.webp
  Cache-Control: public, max-age=31536000, s-maxage=604800

# HTML: cache corto en edge y revalidación en el navegador
/index.html
  Cache-Control: public, max-age=0, s-maxage=3600, must-revalidate
