# Credenciales locales de Supabase Auth.
# Copiar a `supabase/.env` (gitignoreado). La CLI las carga automáticamente.
#
# Google OAuth: crear el cliente en Google Cloud con el redirect
# http://127.0.0.1:54521/auth/v1/callback
# y después activar [auth.external.google] en config.toml.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Opcional: secret real de Turnstile para probar el widget en local.
# En desarrollo se usa la clave de prueba de Cloudflare que ya está en config.toml.
SUPABASE_AUTH_TURNSTILE_SECRET=
