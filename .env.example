# Variables de entorno de Palette Lab (solo desarrollo/BFF)
# Copia este archivo a `.env` y rellena los valores.
# `.env*` está en .gitignore: los secretos NUNCA se suben.

# URL del microservicio palette-lab-api
PALETTE_LAB_API_URL=http://localhost:8010

# Secreto compartido. En producción vive en Cloudflare Pages, no en el navegador.
PALETTE_LAB_API_KEY=

# ---- Supabase local ----
VITE_SUPABASE_URL=http://127.0.0.1:54521
VITE_SUPABASE_ANON_KEY=

# ---- Cloudflare Turnstile ----
# Site key pública del widget. La de prueba siempre pasa.
# En producción va la site key real del dominio de Pages.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ---- Google OAuth (solo stack local de Supabase) ----
# No van acá: se cargan en supabase/.env y se activan en
# [auth.external.google] de supabase/config.toml.
